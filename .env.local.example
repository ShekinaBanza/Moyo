# Moyo — configuration de DÉVELOPPEMENT LOCAL (XAMPP / php artisan serve). Copiez vers `.env` :
#   cp .env.local.example .env && php artisan key:generate
# Aucun secret ici. La configuration de production est dans `.env.example`.

APP_NAME=Moyo
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL local (XAMPP) ou SQLite (DB_CONNECTION=sqlite, DB_DATABASE=database/database.sqlite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=health_companion
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
