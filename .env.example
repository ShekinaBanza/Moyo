# =====================================================================================
# MOYO — modèle de configuration de PRODUCTION (Hostinger Business Web Hosting)
#
# Ce fichier est publié sur GitHub : il ne contient AUCUN secret ni identifiant réel.
# Le vrai fichier `.env` se crée UNIQUEMENT sur le serveur (jamais dans Git) : voir docs/DEPLOY_HOSTINGER.md.
# Les valeurs « CHANGEZ_MOI_* » sont des EXEMPLES à remplacer par celles de hPanel (Bases de données).
# Pour le développement local, copiez plutôt `.env.local.example`.
# =====================================================================================

APP_NAME=Moyo
APP_ENV=production
APP_DEBUG=false
APP_URL=https://rosybrown-giraffe-981859.hostingersite.com

# Générée UNE SEULE FOIS sur le serveur (`php artisan key:generate --force`), puis jamais modifiée :
# la changer déconnecte tous les utilisateurs et rend illisibles les valeurs chiffrées.
APP_KEY=

# Langue de l'interface : français.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Les dates sont STOCKÉES en UTC (aucun décalage possible). Le fuseau de chaque utilisateur
# (par défaut Africa/Kinshasa, modifiable dans Notifications > Préférences) sert à l'affichage,
# aux jours calendaires et aux rappels.
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Base de données MySQL (hPanel > Bases de données > Gestion) ---------------------
# EXEMPLES : à remplacer par le nom de base, l'utilisateur et le mot de passe affichés par hPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGEZ_MOI_nom_de_la_base
DB_USERNAME=CHANGEZ_MOI_utilisateur_mysql
DB_PASSWORD=CHANGEZ_MOI_mot_de_passe_mysql

# --- Sessions, cache, files d'attente (aucun serveur permanent requis) ---------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Authentification SPA par cookie (Sanctum) : domaine du site, sans https:// -------
SANCTUM_STATEFUL_DOMAINS=rosybrown-giraffe-981859.hostingersite.com

# --- E-mails (réinitialisation du mot de passe) ---------------------------------------
# Par défaut « log » : AUCUN e-mail n'est envoyé (ils sont seulement écrits dans les logs).
# Pour de vrais e-mails, créez une boîte dans hPanel > E-mails puis décommentez et complétez :
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=CHANGEZ_MOI_adresse_email
# MAIL_PASSWORD=CHANGEZ_MOI_mot_de_passe_email
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Notifications du navigateur (Web Push) : facultatif --------------------------------
# Générer avec `php artisan webpush:vapid`, coller ici UNIQUEMENT dans le .env du serveur.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@example.com

# --- Variables lues à la COMPILATION du frontend (npm run build), pas au runtime ------
# Fond de carte : OpenStreetMap par défaut (usage léger). Une clé de tuiles côté navigateur est publique :
# restreignez-la par domaine chez le fournisseur. Ne jamais mettre de clé secrète ici.
# VITE_TILE_URL=
# VITE_TILE_ATTRIBUTION=
